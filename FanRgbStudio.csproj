<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FanRgbStudio</AssemblyName><RootNamespace>FanRgbStudio</RootNamespace>
    <Version>1.6.0</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" /></ItemGroup>
  <ItemGroup><Compile Remove="docs/**/*.cs;backups/**/*.cs;tools/**/*.cs"/><Page Remove="backups/**/*.xaml"/><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
</Project>
