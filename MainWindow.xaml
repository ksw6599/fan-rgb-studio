<Window x:Class="FanRgbStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="선웅 Fan Studio" Width="1180" Height="900" MinWidth="1020" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#101218" Foreground="#ECF0F5" FontFamily="Malgun Gothic" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#939CAD"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#29313D"/><Setter Property="Foreground" Value="#F2F6FA"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#A7F3E4"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#15202B"/><Setter Property="Background" Value="#E2E8F0"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#12171F"/><Setter Property="Foreground" Value="#ECF0F5"/><Setter Property="BorderBrush" Value="#3B4658"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,10,0,10"/><Setter Property="AutoToolTipPlacement" Value="TopLeft"/><Setter Property="AutoToolTipPrecision" Value="0"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="TickFrequency" Value="1"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B202B"/><Setter Property="BorderBrush" Value="#2C3341"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#939CAD"/><Setter Property="FontSize" Value="12"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#161A22" BorderBrush="#29303B" BorderThickness="0,0,1,0" Padding="23,28">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="◉" FontSize="36" Foreground="#53D9C5"/>
     <TextBlock Text="FAN STUDIO" FontSize="20" FontWeight="Bold" Margin="0,10,0,4"/>
     <TextBlock Text="선웅의 PC 컨트롤" Style="{StaticResource Label}"/>
     <Border Height="1" Background="#303746" Margin="0,27,0,24"/>
     <TextBlock Text="내 컴퓨터" Foreground="#53D9C5" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
     <TextBlock x:Name="BoardText" Text="장치 확인 중…" Foreground="#B9C2D1" LineHeight="22"/>
     <TextBlock Text="Windows 11 · 64 bit" Style="{StaticResource Label}" Margin="0,12,0,20"/>
     <TextBlock x:Name="DriverText" Text="센서 드라이버 확인 중" Foreground="#B9C2D1" FontSize="11" Margin="0,0,0,8"/>
     <Button x:Name="DriverButton" Content="센서 드라이버 설치" Click="Driver_Click" Padding="9,11" FontSize="12" Margin="0,0,0,12"/>
     <Button x:Name="AdminButton" Content="관리자로 다시 열기" Click="Admin_Click" Padding="9,11" FontSize="12" Margin="0,0,0,12"/>
     <Button Content="백그라운드로 보내기" Click="Background_Click" Padding="9,11" FontSize="12" Margin="0,0,0,12"/>
     <Button Content="사용 설명서" Click="Help_Click" Margin="0,0,0,12"/>
     <Button Content="진단 폴더 열기" Click="Logs_Click" Margin="0,0,0,12"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom">
     <TextBlock Text="저장한 설정 자동 복원" Foreground="#CAD2DE" FontWeight="Bold" Margin="0,0,0,10"/>
     <TextBlock Text="적용한 팬·조명 설정은 다음 실행에 장치를 확인한 뒤 복원해요." Style="{StaticResource Label}" LineHeight="21"/>
     <TextBlock Text="X 닫기 → 트레이에서 계속 실행" Foreground="#A9B9CC" FontSize="10" Margin="0,18,0,0"/>
     <TextBlock x:Name="VersionText" Text="Fan Studio · LOCAL ONLY" Foreground="#6C788D" FontSize="10" Margin="0,10,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="30,28,30,24">
    <DockPanel Margin="0,0,0,22">
     <Border DockPanel.Dock="Right" Background="#242D36" CornerRadius="12" Padding="13,8" VerticalAlignment="Top"><TextBlock x:Name="AccessText" Text="장치 연결 중" Foreground="#93E5D3" FontSize="11"/></Border>
     <StackPanel><TextBlock Text="내 PC, 내 페이스로." FontSize="29" FontWeight="Bold"/><TextBlock Text="온도와 바람, 그리고 빛을 한 곳에서." Foreground="#939CAD" Margin="0,7,0,0"/></StackPanel>
    </DockPanel>
    <UniformGrid Columns="3" Margin="0,0,0,20">
     <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="19"><StackPanel><TextBlock Text="CPU 온도" Style="{StaticResource Label}"/><TextBlock x:Name="CpuText" Text="— °C" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="CpuDetail" Text="실제 센서 대기 중" Style="{StaticResource Label}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="19"><StackPanel><TextBlock Text="GPU 온도" Style="{StaticResource Label}"/><TextBlock x:Name="GpuText" Text="— °C" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="감지된 GPU의 최고 온도" Style="{StaticResource Label}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="19"><StackPanel><TextBlock Text="감지된 팬 센서" Style="{StaticResource Label}"/><TextBlock x:Name="RpmText" Text="— RPM" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="RpmDetail" Text="센서 연결 확인 중" Style="{StaticResource Label}"/></StackPanel></Border>
    </UniformGrid>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.06*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,16,0">
      <StackPanel>
       <TextBlock Text="01   팬 속도" Foreground="#53D9C5" FontSize="12" FontWeight="Bold"/>
       <TextBlock Text="필요한 만큼의 바람" FontSize="21" FontWeight="Bold" Margin="0,9,0,5"/>
       <TextBlock Text="조절할 채널을 선택하세요." Style="{StaticResource Label}"/>
       <Border Background="#131821" CornerRadius="9" Padding="12" Margin="0,16,0,12"><ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChannelList"><TextBlock Text="팬 제어 채널을 찾고 있어요…" Foreground="#939CAD"/></StackPanel></ScrollViewer></Border>
       <TextBlock Text="속도 프로필" Style="{StaticResource Label}"/>
       <ComboBox x:Name="FanMode" SelectionChanged="FanMode_Changed" AutomationProperties.Name="팬 속도 프로필"><ComboBoxItem Content="저소음"/><ComboBoxItem Content="균형" IsSelected="True"/><ComboBoxItem Content="성능"/><ComboBoxItem Content="수동"/><ComboBoxItem Content="사용자 곡선"/></ComboBox>
       <StackPanel x:Name="ManualControls">
       <DockPanel><TextBlock x:Name="ManualLabel" DockPanel.Dock="Right" Text="50%" Foreground="#53D9C5"/><TextBlock Text="수동 출력 (30–100%)" Style="{StaticResource Label}"/></DockPanel>
       <Slider x:Name="ManualSlider" Minimum="30" Maximum="100" Value="50" TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="1" ValueChanged="Manual_Changed" AutomationProperties.Name="수동 팬 출력" IsEnabled="False"/>
       <WrapPanel x:Name="ManualEditor" IsEnabled="False" Margin="0,2,0,8" VerticalAlignment="Center">
        <Button Content="−1" Tag="-1" Click="ManualStep_Click" Padding="8,6" AutomationProperties.Name="팬 출력 1퍼센트 낮추기"/>
        <Button Content="−0.1" Tag="-0.1" Click="ManualStep_Click" Padding="8,6" AutomationProperties.Name="팬 출력 0.1퍼센트 낮추기"/>
        <TextBox x:Name="ManualValueInput" Text="50.0" Width="66" Margin="0,0,5,0" VerticalContentAlignment="Center" LostFocus="ManualInput_LostFocus" KeyDown="ManualInput_KeyDown" AutomationProperties.Name="수동 팬 출력 직접 입력"/>
        <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Content="+0.1" Tag="0.1" Click="ManualStep_Click" Padding="8,6" AutomationProperties.Name="팬 출력 0.1퍼센트 높이기"/>
        <Button Content="+1" Tag="1" Click="ManualStep_Click" Padding="8,6" AutomationProperties.Name="팬 출력 1퍼센트 높이기"/>
       </WrapPanel>
       <TextBlock Text="0.1% 단위로 입력 · Enter로 확정 · 실제 출력은 팬 제어기의 PWM 단위로 반영됩니다." Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,8"/>
       </StackPanel>
       <StackPanel x:Name="CustomCurvePanel" Visibility="Collapsed" Margin="0,0,0,8">
        <TextBlock Text="온도별 팬 출력" Foreground="#53D9C5" FontWeight="SemiBold" Margin="0,4,0,7"/>
        <TextBlock Text="온도와 출력을 직접 편집하세요. 지점 사이는 부드럽게 연결되며, 마지막 85°C / 100%는 보호 지점입니다." Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,9"/>
        <DataGrid x:Name="CustomCurveGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="260" MinHeight="100" RowHeight="31" Background="#131821" Foreground="#ECF0F5" RowBackground="#19212C" AlternatingRowBackground="#1E2835" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#303B4B" AutomationProperties.Name="온도 구간별 팬 곡선">
         <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293644"/><Setter Property="Foreground" Value="#DCE8F2"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.ColumnHeaderStyle>
         <DataGrid.Resources><Style x:Key="CurveCellText" TargetType="TextBlock"><Setter Property="Foreground" Value="#ECF0F5"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style><Style x:Key="CurveEditText" TargetType="TextBox"><Setter Property="Foreground" Value="#101218"/><Setter Property="Background" Value="#F3F6FA"/><Setter Property="Padding" Value="5,2"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
         <DataGrid.Columns>
          <DataGridTextColumn Header="온도 (°C)" Width="*" Binding="{Binding Temperature,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CurveCellText}" EditingElementStyle="{StaticResource CurveEditText}"/>
          <DataGridTextColumn Header="팬 출력 (%)" Width="*" Binding="{Binding Duty,UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CurveCellText}" EditingElementStyle="{StaticResource CurveEditText}"/>
         </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,9,0,0"><Button Content="지점 추가" Click="AddCurvePoint_Click" Padding="9,6"/><Button Content="선택 삭제" Click="RemoveCurvePoint_Click" Padding="9,6"/><Button Content="기본 곡선" Click="ResetCurve_Click" Padding="9,6"/></WrapPanel>
        <TextBlock x:Name="CurveValidationText" Text="온도 지점을 편집한 뒤 팬 설정 적용을 누르세요." Foreground="#A9B9CC" FontSize="10" Margin="0,8,0,0"/>
       </StackPanel>
       <Border Background="#131821" CornerRadius="9" Padding="8" Margin="0,3,0,12"><StackPanel><Canvas x:Name="CurveCanvas" Height="100" ClipToBounds="True" SizeChanged="Curve_SizeChanged"/><DockPanel><TextBlock Text="20°C" Foreground="#79869B" FontSize="10"/><TextBlock Text="85°C → 최대 출력" Foreground="#79869B" FontSize="10" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
       <TextBlock Text="자동 프로필은 CPU·GPU 최고 온도를 따릅니다. 펌프 채널은 선택하지 마세요." Style="{StaticResource Label}" LineHeight="19" Margin="0,0,0,16"/>
       <WrapPanel><Button x:Name="ApplyFanButton" Content="팬 설정 적용" Background="#53D9C5" Foreground="#102A29" Click="ApplyFan_Click" IsEnabled="False"/><Button x:Name="RestoreButton" Content="기본 제어 복원" Click="Restore_Click"/></WrapPanel>
       <TextBlock Text="적용한 채널별 속도는 자동 저장·복원됩니다. 기본 제어 복원은 저장된 팬 설정도 지웁니다." Style="{StaticResource Label}" FontSize="10" Margin="0,10,0,0"/>
       <TextBlock x:Name="FanNotice" Text="팬 설정을 읽는 중입니다." Foreground="#A9B9CC" FontSize="11" Margin="0,14,0,0" LineHeight="19"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Style="{StaticResource Card}">
      <StackPanel x:Name="RgbPanel">
       <DockPanel><Button x:Name="ConnectRgbButton" DockPanel.Dock="Right" Content="RGB 연결" Click="ConnectRgb_Click" Padding="10,6" FontSize="11"/><TextBlock Text="02   RGB 조명" Foreground="#BFA8FF" FontSize="12" FontWeight="Bold"/></DockPanel>
       <TextBlock Text="내 취향의 빛" FontSize="21" FontWeight="Bold" Margin="0,9,0,5"/>
       <TextBlock Text="OpenRGB에서 감지된 장치를 제어합니다." Style="{StaticResource Label}"/>
       <Grid Height="85" Margin="0,10,0,4">
        <Ellipse x:Name="PreviewGlow" Width="79" Height="79" Stroke="#53D9C5" StrokeThickness="7" Opacity="0.22"/>
        <Ellipse x:Name="PreviewRing" Width="67" Height="67" Stroke="#53D9C5" StrokeThickness="4"/>
        <Path Data="M 0,-28 C 31,-29 35,-1 9,1 C 29,27 -2,36 -6,10 C -32,24 -37,-5 -10,-6 C -27,-31 -1,-40 0,-12 Z" Fill="#718897" Stretch="Uniform" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse Width="18" Height="18" Fill="#222C38" Stroke="#697A91" StrokeThickness="2"/>
       </Grid>
       <TextBlock x:Name="RgbPreviewCaption" Text="미리보기 · 실제 조명 상태와 별개" HorizontalAlignment="Center" Foreground="#79869B" FontSize="10" Margin="0,0,0,13"/>
       <Button x:Name="CaseFanButton" Content="시스템 팬 조명 선택" Click="CaseFan_Click" Padding="12,7" HorizontalAlignment="Left" Margin="0,0,0,7" IsEnabled="False"/>
       <ComboBox x:Name="RgbDevices" DisplayMemberPath="Label" SelectionChanged="RgbDevice_Changed" AutomationProperties.Name="RGB 장치"/>
       <TextBlock Text="조명 구역" Style="{StaticResource Label}"/>
       <ComboBox x:Name="RgbZones" DisplayMemberPath="Label" AutomationProperties.Name="RGB 조명 구역"/>
       <TextBlock Text="구역별 색상은 단색 모드를 사용하세요. 효과 변경은 장치 전체에 적용되며, LED 수는 실제 팬 개수가 아닙니다." Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,10"/>
       <TextBlock Text="장치 효과" Style="{StaticResource Label}"/>
       <ComboBox x:Name="RgbEffects" DisplayMemberPath="Name" SelectionChanged="RgbEffect_Changed" AutomationProperties.Name="RGB 효과"/>
       <TextBlock x:Name="RgbCapabilityText" Text="효과를 선택하면 지원하는 색상·밝기·속도를 표시합니다." Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,9"/>
       <StackPanel x:Name="RgbSpeedPanel" Visibility="Collapsed">
        <TextBlock x:Name="RgbSpeedLabel" Text="효과 속도 50%" Foreground="#BFA8FF"/>
        <Slider x:Name="RgbSpeedSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSpeed_Changed" AutomationProperties.Name="RGB 효과 속도"/>
        <TextBlock Text="장치가 제공하는 범위 기준입니다. 일부 장치는 속도 0에서 효과가 멈춥니다." Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,8"/>
       </StackPanel>
       <StackPanel x:Name="RgbColorEditor">
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="HEX 색상" Foreground="#939CAD" FontSize="11" VerticalAlignment="Center"/><TextBox x:Name="ColorInput" Text="#53D9C5" Width="130" HorizontalAlignment="Left" TextChanged="Color_Changed" AutomationProperties.Name="RGB HEX 색상"/></DockPanel>
       <WrapPanel x:Name="Swatches" Margin="0,12,0,12"/>
       </StackPanel>
       <DockPanel><TextBlock x:Name="BrightnessLabel" DockPanel.Dock="Right" Text="밝기 70%" Foreground="#BFA8FF"/><TextBlock Text="밝기" Style="{StaticResource Label}"/></DockPanel>
       <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="70" ValueChanged="Brightness_Changed" AutomationProperties.Name="RGB 밝기"/>
       <Expander x:Name="RgbCalibrationPanel" Header="실제 LED 색상 보정 · 장치별 저장" Foreground="#BFA8FF" Margin="0,8,0,12">
        <StackPanel Margin="0,10,0,0">
         <TextBlock Text="강하게 보이는 색을 낮춘 뒤 조명 설정 적용을 누르세요. 화면과 LED의 완전한 색 일치를 보장하지 않습니다." Style="{StaticResource Label}" FontSize="10"/>
         <TextBlock Text="{Binding ElementName=RedGain,Path=Value,StringFormat=빨강 {0:F0}%}"/><Slider x:Name="RedGain" Minimum="0" Maximum="200" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="빨강 색상 보정"/>
         <TextBlock Text="{Binding ElementName=GreenGain,Path=Value,StringFormat=초록 {0:F0}%}"/><Slider x:Name="GreenGain" Minimum="0" Maximum="200" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="초록 색상 보정"/>
         <TextBlock Text="{Binding ElementName=BlueGain,Path=Value,StringFormat=파랑 {0:F0}%}"/><Slider x:Name="BlueGain" Minimum="0" Maximum="200" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="파랑 색상 보정"/>
         <WrapPanel><Button Content="노랑·초록 줄이기" Click="ReduceGreen_Click"/><Button Content="보정 초기화" Click="ResetCalibration_Click"/></WrapPanel>
        </StackPanel>
       </Expander>
       <WrapPanel Margin="0,4,0,0"><Button x:Name="ApplyRgbButton" Content="조명 설정 적용" Background="#BFA8FF" Foreground="#251D3B" Click="ApplyRgb_Click" IsEnabled="False"/><Button x:Name="SolidRgbButton" Content="단색으로 켜기" Click="SolidRgb_Click" IsEnabled="False"/></WrapPanel>
       <WrapPanel Margin="0,9,0,0"><Button x:Name="RestartRgbEffectButton" Content="효과 다시 시작" Click="RestartRgbEffect_Click" Padding="10,7" IsEnabled="False"/><Button x:Name="RecoverRgbButton" Content="RGB 복구" Click="RecoverRgb_Click" Padding="10,7"/><Button x:Name="ExportRgbButton" Content="RGB 진단 저장" Click="ExportRgb_Click" Padding="10,7"/></WrapPanel>
       <Button x:Name="RestoreRgbButton" Content="저장된 조명 다시 적용" Click="RestoreRgb_Click" Padding="10,7" HorizontalAlignment="Left" Margin="0,9,0,0" IsEnabled="False"/>
       <TextBlock x:Name="RgbNotice" Text="RGB 연결을 누르면 조명 엔진을 시작합니다." Foreground="#A9B9CC" FontSize="11" Margin="0,14,0,0" LineHeight="19"/>
       <TextBlock x:Name="RgbRestoreNotice" Text="적용한 장치별 조명 설정을 자동 저장하고 로그인 후 다시 적용합니다." Foreground="#939CAD" FontSize="10" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
     <StackPanel>
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="DisplayConnectButton" Content="디스플레이 연결" Click="DisplayConnect_Click"/><Button Content="전송 중지" Click="DisplayStop_Click"/><Button Content="TRCC로 돌아가기" Click="OpenTrcc_Click"/></StackPanel><StackPanel><TextBlock Text="03   쿨러 숫자 디스플레이" Foreground="#F7B86A" FontSize="12" FontWeight="Bold"/><TextBlock Text="PA120 DIGITAL" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></DockPanel>
      <TextBlock Text="CPU 온도·사용률과 GPU 온도·사용률을 쿨러의 실제 숫자 화면으로 보냅니다." Foreground="#939CAD" Margin="0,9,0,16"/>
      <UniformGrid Columns="4"><StackPanel><CheckBox x:Name="ShowCpuTemp" Content="CPU 온도" IsChecked="True" Foreground="#D2DCE8"/><TextBlock x:Name="DisplayCpuTemp" Text="— °C" FontSize="28" Foreground="#53D9C5" Margin="0,8,0,12"/></StackPanel><StackPanel><CheckBox x:Name="ShowCpuLoad" Content="CPU 사용률" IsChecked="True" Foreground="#D2DCE8"/><TextBlock x:Name="DisplayCpuLoad" Text="— %" FontSize="28" Foreground="#53D9C5" Margin="0,8,0,12"/></StackPanel><StackPanel><CheckBox x:Name="ShowGpuTemp" Content="GPU 온도" IsChecked="True" Foreground="#D2DCE8"/><TextBlock x:Name="DisplayGpuTemp" Text="— °C" FontSize="28" Foreground="#BFA8FF" Margin="0,8,0,12"/></StackPanel><StackPanel><CheckBox x:Name="ShowGpuLoad" Content="GPU 사용률" IsChecked="True" Foreground="#D2DCE8"/><TextBlock x:Name="DisplayGpuLoad" Text="— %" FontSize="28" Foreground="#BFA8FF" Margin="0,8,0,12"/></StackPanel></UniformGrid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="디스플레이 색상 효과" Style="{StaticResource Label}"/><ComboBox x:Name="DisplayEffect" AutomationProperties.Name="디스플레이 효과"><ComboBoxItem Content="온도에 따라" IsSelected="True"/><ComboBoxItem Content="단색"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="단색 HEX" Style="{StaticResource Label}"/><TextBox x:Name="DisplayColorInput" Text="#53D9C5" Margin="0,6,0,0" AutomationProperties.Name="디스플레이 HEX 색상"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="디스플레이 밝기" Style="{StaticResource Label}"/><Slider x:Name="DisplayBrightness" Value="70" Minimum="0" Maximum="100" AutomationProperties.Name="디스플레이 밝기"/></StackPanel></Grid>
      <TextBlock x:Name="DisplayNotice" Text="TRCC를 종료한 뒤 ‘디스플레이 연결’을 누르세요. 이 앱과 TRCC를 동시에 연결하지 않습니다." Foreground="#A9B9CC" FontSize="12" Margin="0,9,0,0"/>
      <TextBlock Text="연결 중에는 선택한 항목·색상·밝기가 다음 갱신에 반영됩니다. CPU 온도를 못 읽으면 숫자 대신 —로 표시합니다." Style="{StaticResource Label}" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <DockPanel Margin="0,18,0,0"><Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Content="내 설정 저장" Click="Save_Click" Padding="13,7" FontSize="11"/><TextBlock x:Name="StatusText" Text="적용한 팬 설정은 다음 실행에 자동 복원됩니다." Foreground="#8290A5" FontSize="11" VerticalAlignment="Center"/></DockPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
